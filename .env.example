# ==========================================
# Geo - Personal AI Brother & WhatsApp Agent
# Environment Configuration
# ==========================================

# Server Port
PORT=3000

# Agent & Owner Identity
AGENT_NAME="Geo"
OWNER_NAME="Galib Mahmud"

# ------------------------------------------
# LLM Provider Configuration (All 100% Free!)
# Choose one: "openrouter" | "gemini" | "groq"
# ------------------------------------------
LLM_PROVIDER=openrouter

# 1. OpenRouter (Supports free Nous Hermes 3 & Open Source models)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b:free

# 2. Google Gemini (Free tier with 15 RPM)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. Groq (Ultra-fast free Llama 3)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------
# Cloud Persistence (For 24/7 Render Deploy)
# ------------------------------------------
# Optional but HIGHLY recommended for Render free tier:
# Get free 512MB MongoDB Atlas at https://www.mongodb.com/cloud/atlas
# Keeps your WhatsApp linked even if Render restarts or redeploys!
# If left blank, session will be saved locally on disk (./auth_info_baileys).
MONGODB_URI=

# ------------------------------------------
# Render Keep-Alive (Prevents Free Tier Sleep)
# ------------------------------------------
# Your public Render URL (e.g. https://geo-agent.onrender.com)
RENDER_EXTERNAL_URL=

# ------------------------------------------
# WhatsApp Automation Rules
# ------------------------------------------
# Reply to group messages? (true/false) - Recommend false to prevent spamming groups
REPLY_TO_GROUPS=false

# Reply when you message yourself / test notes? (true/false)
REPLY_TO_SELF=false

# Typing simulation delay in milliseconds (makes replies look human)
TYPING_DELAY_MS=2000
